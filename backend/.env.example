NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://postgres:postgres@localhost:55432/ai_code_security_reviewer
REDIS_URL=redis://localhost:6380

UPLOAD_DIR=./storage/uploads
WORKSPACE_DIR=./storage/workspaces
MAX_UPLOAD_MB=50

CLERK_AUTH_ENABLED=false
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

AUTH_SESSION_SECRET=change-this-local-secret
ADMIN_EMAIL=
ADMIN_PASSWORD=

AI_ANALYSIS_ENABLED=false
AI_PROVIDER=groq
# Set GROQ_CLOUD_API_KEY and GROQ_CLOUD_MODEL for GroqCloud chat and analysis.
AI_MAX_FILES=20
AI_MAX_CHARS_PER_FILE=12000

SEMGREP_ENABLED=false
SEMGREP_CONFIG=auto
SEMGREP_TIMEOUT_MS=60000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b
OLLAMA_API_KEY=

GROQ_CLOUD_API_KEY=
GROQ_CLOUD_MODEL=groq-1.0
